# Allowlist des permissions de l'APK release Android.
#
# Référence : ADR-0003 (ACTÉ), qui met en œuvre l'ADR-0002.
# doc/dev/decisions/ADR-0003-permission-mapping.md
#
# Règles :
#   - chaque entrée renvoie à sa référence dans l'ADR-0003 (A1, A2…) ;
#   - une permission AUTORISÉE — CONDITIONNELLE n'est ajoutée qu'avec la
#     fonction qui l'introduit, après observation dans l'APK ;
#   - une permission INTERDITE ou HORS TABLE n'est jamais ajoutée ici sans
#     amendement préalable de l'ADR-0003.
#
# Format : <type> <nom>  # <référence ADR-0003>
# ${applicationId} = identifiant du package.

# A1 — technique interne AndroidX, observée au T0 (13 septembre 2026).
permission ${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION  # A1
uses-permission ${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION  # A1
